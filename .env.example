# NSS TGPCOP Environment Variables
# Fill in your Supabase & Brevo values in Vercel -> Settings -> Environment Variables
# (Do NOT commit real keys to GitHub)

# 1. Supabase Project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=

# 2. Supabase Anon Public Key (anon public key)
SUPABASE_ANON_KEY=

# 3. Cloudinary White Transparent Logo Link (Optional)
CLOUDINARY_LOGO_URL=

# 4. Brevo (Sendinblue) Email Integration
# Create a free Brevo account at https://www.brevo.com
# Get your API key from Brevo -> SMTP & API -> API Keys (starts with xkeysib-...)
BREVO_API_KEY=

# 5. Brevo Verified Sender Email
# The email address verified in your Brevo account (e.g., Media@tgpcop.site or your email)
BREVO_SENDER_EMAIL=Media@tgpcop.site

# 6. Brevo Sender Name
BREVO_SENDER_NAME=NSS TGPCOP
